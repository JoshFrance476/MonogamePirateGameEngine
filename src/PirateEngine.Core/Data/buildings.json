// Buildings occupy one land tile. Placement: the ship must be docked, the tile within
// config.dockReach of the dock on the same island, on an allowed biome (empty = any buildable).
// Recipes are tried round-robin; inputs are delivered by ship, outputs collected by ship.
// "goldOutput" pays straight into the treasury. "services" unlock dock-panel actions.
//
// Production chains:
//   wood ─► Sawmill ─► planks ─► (repairs, ship upgrades)
//   iron_ore + wood ─► Smelter ─► iron ─► Foundry ─► cannonballs (ammo)
//   cotton ─► Weaver ─► cloth ─► Sailmaker ─► sails ─► (ship upgrades)
//   sugarcane ─► Distillery ─► rum ─► Market ─► gold
//   grain + fish ─► Galley Kitchen ─► rations ─► Market ─► gold
[
  // ---------------- raw producers ----------------
  { "id": "lumber_camp", "name": "Lumber Camp", "glyph": "L", "color": "#4E7D3A",
    "description": "Fells timber. Must be built in forest, jungle, taiga or swamp.",
    "allowedBiomes": ["TemperateForest", "Jungle", "Taiga", "Swamp"],
    "goldCost": 40, "buildCost": {}, "storage": 30,
    "recipes": [ { "outputs": { "wood": 2 }, "cycleSeconds": 6 } ] },

  { "id": "quarry", "name": "Quarry", "glyph": "Q", "color": "#8A8580",
